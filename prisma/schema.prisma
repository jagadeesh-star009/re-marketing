datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

enum Role {
  REQUIREMENT_OWNER
  VENDOR
  ADMIN
}

enum RequirementType {
  PRODUCT
  SERVICE
}

enum RequirementStatus {
  DRAFT
  PUBLISHED
  UNDER_REVIEW
  MATCHED
  SHORTLISTED
  VENDOR_SELECTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  EXPIRED
}

enum OfferStatus {
  SUBMITTED
  UNDER_REVIEW
  SHORTLISTED
  SELECTED
  REJECTED
  WITHDRAWN
}

enum SelectionStatus {
  PENDING
  IN_PROGRESS
  DELIVERED
  ACCEPTED
  COMPLETED
  DISPUTED
  CANCELLED
}

enum CategoryType {
  PRODUCT
  SERVICE
  BOTH
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         Role      @default(REQUIREMENT_OWNER)
  avatarUrl    String?
  phone        String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  userProfile      UserProfile?
  vendorProfile    VendorProfile?
  requirements     Requirement[]    @relation("OwnerRequirements")
  offers           Offer[]          @relation("VendorOffers")
  shortlists       Shortlist[]      @relation("OwnerShortlists")
  selections       Selection[]      @relation("OwnerSelections")
  sentMessages     Message[]        @relation("SentMessages")
  notifications    Notification[]
  reviewsGiven     Review[]         @relation("ReviewsGiven")
  reviewsReceived  Review[]         @relation("ReviewsReceived")
  reportsSubmitted Report[]         @relation("UserReports")

  @@index([role])
  @@index([email])
}

model UserProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  companyName String?
  bio         String?
  website     String?
  address     String?
  city        String?
  state       String?
  country     String?  @default("India")
  pincode     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VendorProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  businessName       String
  tagline            String?
  description        String
  logoUrl            String?
  website            String?
  phone              String?
  address            String?
  city               String
  state              String
  country            String   @default("India")
  pincode            String?
  serviceRadiusKm    Float?   @default(50.0)
  isRemoteAvailable  Boolean  @default(true)
  experienceYears    Int      @default(3)
  rating             Float    @default(5.0)
  reviewCount        Int      @default(0)
  completedOrders    Int      @default(0)
  responseRate       Float    @default(98.0)
  verified           Boolean  @default(true)
  categoriesProvided String?  // Comma-separated or JSON list of category IDs/names
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user               User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  products           VendorProduct[]
  services           VendorService[]
  capabilities       VendorCapability[]
  offers             Offer[]
  shortlists         Shortlist[]
  selections         Selection[]
  compatibilityScores CompatibilityScore[]

  @@index([rating])
  @@index([city])
}

model Category {
  id          String        @id @default(cuid())
  name        String        @unique
  slug        String        @unique
  description String?
  type        CategoryType  @default(BOTH)
  icon        String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  subcategories Subcategory[]
  requirements  Requirement[]
  capabilities  VendorCapability[]
  products      VendorProduct[]
  services      VendorService[]
}

model Subcategory {
  id          String   @id @default(cuid())
  categoryId  String
  name        String
  slug        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category     Category           @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  requirements Requirement[]
  capabilities VendorCapability[]

  @@unique([categoryId, slug])
}

model VendorCapability {
  id              String   @id @default(cuid())
  vendorId        String
  categoryId      String
  subcategoryId   String?
  experienceYears Int      @default(2)
  tags            String?  // JSON string array of skills or product keywords
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  vendor      VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  category    Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subcategory Subcategory?  @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)

  @@index([vendorId])
  @@index([categoryId])
}

model VendorProduct {
  id            String   @id @default(cuid())
  vendorId      String
  categoryId    String
  title         String
  description   String
  brand         String?
  model         String?
  price         Float
  currency      String   @default("INR")
  stockQuantity Int      @default(10)
  warranty      String?  @default("1 Year")
  returnPolicy  String?  @default("7-Day Return")
  leadTimeDays  Int      @default(3)
  imageUrl      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  vendor   VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  category Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([categoryId])
}

model VendorService {
  id                 String   @id @default(cuid())
  vendorId           String
  categoryId         String
  title              String
  description        String
  skills             String?  // JSON string array of skills
  hourlyRate         Float?
  fixedStartingPrice Float?
  currency           String   @default("INR")
  deliveryDays       Int      @default(14)
  isRemote           Boolean  @default(true)
  portfolioUrl       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  vendor   VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  category Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([categoryId])
}

model Requirement {
  id                    String            @id @default(cuid())
  ownerId               String
  type                  RequirementType
  title                 String
  description           String
  categoryId            String
  subcategoryId         String?
  quantity              Int               @default(1)
  minBudget             Float
  maxBudget             Float
  preferredBudget       Float?
  currency              String            @default("INR")

  // Product specific
  requiredDeliveryDate  DateTime?
  preferredDeliveryDate DateTime?

  // Service specific
  projectStartDate      DateTime?
  projectDeadline       DateTime?
  expectedDurationDays  Int?

  // Location
  country               String            @default("India")
  state                 String?
  city                  String?
  pincode               String?
  isRemote              Boolean           @default(false)

  status                RequirementStatus @default(PUBLISHED)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  owner               User                        @relation("OwnerRequirements", fields: [ownerId], references: [id], onDelete: Cascade)
  category            Category                    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subcategory         Subcategory?                @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  specifications      RequirementSpecification[]
  attachments         RequirementAttachment[]
  offers              Offer[]
  shortlists          Shortlist[]
  selections          Selection[]
  conversations       Conversation[]
  compatibilityScores CompatibilityScore[]
  reviews             Review[]

  @@index([ownerId])
  @@index([categoryId])
  @@index([status])
  @@index([createdAt])
}

model RequirementSpecification {
  id            String   @id @default(cuid())
  requirementId String
  specKey       String
  specValue     String
  isRequired    Boolean  @default(true)
  createdAt     DateTime @default(now())

  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@index([requirementId])
}

model RequirementAttachment {
  id            String   @id @default(cuid())
  requirementId String
  fileUrl       String
  fileName      String
  fileType      String
  fileSize      Int
  createdAt     DateTime @default(now())

  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@index([requirementId])
}

model Offer {
  id                 String      @id @default(cuid())
  requirementId      String
  vendorId           String
  vendorProfileId    String
  offeredPrice       Float
  currency           String      @default("INR")
  quantity           Int         @default(1)

  // Product delivery
  deliveryDate       DateTime?
  shippingCost       Float       @default(0.0)
  additionalCharges  Float       @default(0.0)
  warranty           String?
  returnPolicy       String?

  // Service scope
  startDate          DateTime?
  completionDate     DateTime?
  estimatedDuration  String?
  deliverables       String?
  milestonesJson     String?

  description        String
  vendorNotes        String?
  status             OfferStatus @default(SUBMITTED)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  requirement        Requirement          @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  vendor             User                 @relation("VendorOffers", fields: [vendorId], references: [id], onDelete: Cascade)
  vendorProfile      VendorProfile        @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)
  specifications     OfferSpecification[]
  attachments        OfferAttachment[]
  compatibilityScore CompatibilityScore?
  shortlists         Shortlist[]
  selections         Selection[]
  conversations      Conversation[]

  @@unique([requirementId, vendorId])
  @@index([requirementId])
  @@index([vendorId])
  @@index([status])
}

model OfferSpecification {
  id        String   @id @default(cuid())
  offerId   String
  specKey   String
  specValue String
  createdAt DateTime @default(now())

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([offerId])
}

model OfferAttachment {
  id        String   @id @default(cuid())
  offerId   String
  fileUrl   String
  fileName  String
  fileType  String
  fileSize  Int
  createdAt DateTime @default(now())

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([offerId])
}

model CompatibilityScore {
  id                 String   @id @default(cuid())
  requirementId      String
  offerId            String?  @unique
  vendorProfileId    String
  overallScore       Float    // 0 - 100
  budgetScore        Float    // 0 - 100 (30% weight)
  relevanceScore     Float    // 0 - 100 (30% weight)
  deliveryScore      Float    // 0 - 100 (20% weight)
  locationScore      Float    // 0 - 100 (10% weight)
  vendorQualityScore Float    // 0 - 100 (10% weight)
  breakdownJson      String?  // JSON explanation
  calculatedAt       DateTime @default(now())

  requirement   Requirement   @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  offer         Offer?        @relation(fields: [offerId], references: [id], onDelete: Cascade)
  vendorProfile VendorProfile @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)

  @@index([requirementId])
  @@index([vendorProfileId])
  @@index([overallScore])
}

model Shortlist {
  id            String   @id @default(cuid())
  requirementId String
  offerId       String
  vendorId      String
  ownerId       String
  notes         String?
  createdAt     DateTime @default(now())

  requirement   Requirement   @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  offer         Offer         @relation(fields: [offerId], references: [id], onDelete: Cascade)
  vendorProfile VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  owner         User          @relation("OwnerShortlists", fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([requirementId, offerId])
  @@index([ownerId])
  @@index([requirementId])
}

model Selection {
  id            String          @id @default(cuid())
  requirementId String          @unique
  offerId       String
  vendorId      String
  ownerId       String
  status        SelectionStatus @default(IN_PROGRESS)
  selectedAt    DateTime        @default(now())
  completedAt   DateTime?

  requirement   Requirement   @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  offer         Offer         @relation(fields: [offerId], references: [id], onDelete: Cascade)
  vendorProfile VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  owner         User          @relation("OwnerSelections", fields: [ownerId], references: [id], onDelete: Cascade)
  reviews       Review[]

  @@index([ownerId])
  @@index([vendorId])
  @@index([status])
}

model Conversation {
  id            String    @id @default(cuid())
  requirementId String
  offerId       String?
  ownerId       String
  vendorId      String
  lastMessageAt DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  offer       Offer?      @relation(fields: [offerId], references: [id], onDelete: SetNull)
  messages    Message[]

  @@unique([requirementId, ownerId, vendorId])
  @@index([ownerId])
  @@index([vendorId])
  @@index([lastMessageAt])
}

model Message {
  id             String              @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  isRead         Boolean             @default(false)
  readAt         DateTime?
  createdAt      DateTime            @default(now())

  conversation Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User                @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  attachments  MessageAttachment[]

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
}

model MessageAttachment {
  id        String   @id @default(cuid())
  messageId String
  fileUrl   String
  fileName  String
  fileType  String
  fileSize  Int
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // OFFER_RECEIVED, OFFER_SHORTLISTED, OFFER_SELECTED, MESSAGE_RECEIVED, REQUIREMENT_EXPIRING, VENDOR_MATCH
  title     String
  message   String
  linkUrl   String?
  isRead    Boolean  @default(false)
  readAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model Review {
  id            String   @id @default(cuid())
  requirementId String
  selectionId   String?
  reviewerId    String
  revieweeId    String
  rating        Int      // 1 to 5
  comment       String
  createdAt     DateTime @default(now())

  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  selection   Selection?  @relation(fields: [selectionId], references: [id], onDelete: SetNull)
  reviewer    User        @relation("ReviewsGiven", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewee    User        @relation("ReviewsReceived", fields: [revieweeId], references: [id], onDelete: Cascade)

  @@unique([requirementId, reviewerId, revieweeId])
  @@index([reviewerId])
  @@index([revieweeId])
}

model Report {
  id          String   @id @default(cuid())
  reporterId  String
  targetType  String   // USER, REQUIREMENT, OFFER, REVIEW
  targetId    String
  reason      String
  details     String?
  status      String   @default("PENDING") // PENDING, RESOLVED, DISMISSED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reporter User @relation("UserReports", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([reporterId])
  @@index([status])
}

model AdminSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

model MatchingWeight {
  id                  String   @id @default(cuid())
  budgetWeight        Float    @default(0.30)
  relevanceWeight     Float    @default(0.30)
  deliveryWeight      Float    @default(0.20)
  locationWeight      Float    @default(0.10)
  vendorQualityWeight Float    @default(0.10)
  isDefault           Boolean  @default(true)
  updatedAt           DateTime @updatedAt
}
